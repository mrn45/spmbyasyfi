rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Collection: Pendaftar
    match /pendaftar/{noDaftar} {
      allow get, list, delete: if true;
      allow create, update: if isValidId(noDaftar) &&
        incoming().noDaftar is string &&
        incoming().nama is string &&
        incoming().nama.size() <= 200 &&
        incoming().nisn is string &&
        incoming().nik is string &&
        incoming().status in ["Baru", "Terverifikasi", "Ditolak"];
    }

    // Collection: WebContent
    match /web_content/{configId} {
      allow read, write: if true;
    }

    // Collection: WaSettings
    match /wa_settings/{configId} {
      allow read, write: if true;
    }
  }
}
